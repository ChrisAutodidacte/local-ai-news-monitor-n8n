      "parameters": {
        "jsCode": "const urls = $input.all().map(i => i.json.url);\nconst pgArray = '{' + urls.map(u => '\"' + u.replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"') + '\"').join(',') + '}';\nreturn [{ json: { urls: pgArray } }];"
      },
