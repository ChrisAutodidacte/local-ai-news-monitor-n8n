    {
      "parameters": {
        "jsCode": "const trigger = $('Execute Workflow Trigger').first().json;\nconst max = Number(trigger.config?.max) || 5;\nconst results = ($json.results || [])\n  .filter(r => r.url)\n  .sort((a, b) => (b.score || 0) - (a.score || 0));\nconst out = [];\nfor (const r of results.slice(0, max * 3)) {\n  out.push({ json: {\n    url: r.url,\n    titre: r.title || '',\n    source_id: trigger.id,\n    source_nom: trigger.nom,\n    profil_analyse: trigger.profil_analyse,\n    origine_texte: 'recherche_web',\n    max\n  }});\n}\nreturn out;"
      },
