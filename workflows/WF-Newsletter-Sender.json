    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT q.id, q.sujet, q.html, a.email, a.prenom\nFROM newsletter_queue q\nJOIN newsletter_abonnes a ON a.id = q.abonne_id\nWHERE q.statut = 'a_envoyer'\nORDER BY q.date_creation;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        368,
        160
