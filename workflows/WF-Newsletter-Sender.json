      "credentials": {
        "postgres": {
          "id": "uakSDX3SNDasm8pd",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE newsletter_queue SET statut = 'envoye', date_envoi = now() WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ $('Emails à envoyer').item.json.id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
