    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Extraire l'adresse email proprement depuis \"Prénom Nom <email@gmail.com>\"\nconst fromRaw = item.From || item.from || '';\nconst emailMatch = fromRaw.match(/<(.+?)>/) || fromRaw.match(/([^\\s]+@[^\\s]+)/);\nconst emailFrom = emailMatch ? emailMatch[1] : fromRaw.trim();\nconst corps_brut = $input.first().json.snippet || '';\nconst corps = corps_brut.split(/Le \\d{2}\\/\\d{2}\\/\\d{4}.*a écrit/)[0].trim();\n\nreturn [{\n  json: {\n    email_from: emailFrom,\n    sujet:      (item.Subject || item.subject || '').slice(0, 500),\n    corps:      corps,\n    gmail_id:   item.id\n  }\n}];"
      },
