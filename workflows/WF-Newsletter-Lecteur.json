    {
      "parameters": {
        "jsCode": "const rejets = ['unsubscribe', 'click here', 'promotion', 'offre spéciale', \n                'viagra', 'casino', 'winner', 'congratulations'];\n\nreturn $input.all().filter(item => {\n  const txt = ((item.json.Subject || '') + ' ' + (item.json.snippet || '')).toLowerCase();\n  return !rejets.some(m => txt.includes(m));\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        144
      ],
      "id": "d16e7e83-f561-43d5-ba60-cc12a0d13841",
      "name": "Filtre mots-clés"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO newsletter_emails_commandes (email_expediteur, sujet_original, corps_original)\nVALUES ($1, $2, '{{ $json.corps.replace(/'/g, \"''\") }}')\nON CONFLICT DO NOTHING;",
        "options": {
          "queryReplacement": "={{ $json.email_from }}\n{{ $json.sujet }}"
        }
      },
