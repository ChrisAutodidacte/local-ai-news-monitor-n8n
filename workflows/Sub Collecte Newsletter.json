    {
      "parameters": {
        "jsCode": "const returnItems = [];\n\nfor (const item of $input.all()) {\n  const email = item.json;\n  const emailId = $('Loop Over Items').item.json.gmailId;\n  const emailBody = email.text || email.body || '';\n  const subject = email.Subject || email.subject || 'Article sans titre';\n\n  const titleRegex = /Article\\s*:\\s*([^\\n]+)/i;\n  const titleMatch = emailBody.match(titleRegex);\n  let extractedTitle = titleMatch ? titleMatch[1].trim() : subject;\n extractedTitle = extractedTitle\n    .replace(/&laquo;/g, '«').replace(/&raquo;/g, '»')\n    .replace(/&rsquo;/g, '\\u2019').replace(/&amp;/g, '&')\n    .replace(/&quot;/g, '\"').replace(/^re:\\s*/i, '').trim();\n\n  const urlLabelRegex = /URL\\s*:\\s*(https?:\\/\\/[^\\s\\r\\n\"\\]]+)/i;\n  const urlLabelMatch = emailBody.match(urlLabelRegex);\n  let extractedUrl = '';\n  if (urlLabelMatch) {\n    extractedUrl = urlLabelMatch[1].trim();\n  } else {\n    const genericUrlRegex = /(https?:\\/\\/[^\\s\\r\\n<>\"]+)/i;\n    const genericMatch = emailBody.match(genericUrlRegex);\n    extractedUrl = genericMatch ? genericMatch[1].trim() : 'aucune';\n  }\n  extractedUrl = extractedUrl.replace(/[\\)\\]\\.\\,]+$/, '');\n\n  returnItems.push({\n    json: {\n      email_id: emailId,\n      titre: extractedTitle,\n      url: extractedUrl\n    }\n  });\n}\nreturn returnItems;"
      },
