    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  if (item.json.texte_source) {\n    let texte = item.json.texte_source;\n    texte = texte.replace(/^[ \\t]+$/gm, '');\n    texte = texte.replace(/[ \\t]{2,}/g, ' ');\n    texte = texte.replace(/\\n{3,}/g, '\\n\\n');\n    texte = texte.trim();\n    item.json.texte_source_propre = texte;\n    const wordCount = texte.split(/\\s+/).length;\n    const isCookieOrError = /accepter les cookies|gérer mes choix|javascript est désactivé|panneau de gestion des cookies|veuillez patienter/i.test(texte);\n    let isValid = true;\n    let reason = 'Article valide';\n    if (wordCount < 150) {\n      isValid = false;\n      reason = `Texte trop court (${wordCount} mots).`;\n    } else if (isCookieOrError && wordCount < 300) {\n      isValid = false;\n      reason = 'Bannière de cookies ou mur anti-robot détecté.';\n    }\n    item.json.validation = { is_valid: isValid, word_count: wordCount, reason };\n  } else {\n    item.json.texte_source_propre = '';\n    item.json.validation = { is_valid: false, word_count: 0, reason: 'Aucun texte extrait.' };\n  }\n}\nreturn $input.all();"
      },
