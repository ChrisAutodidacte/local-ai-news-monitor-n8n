    {
      "parameters": {
        "jsCode": "const returnItems = [];\n\nfor (const item of $input.all()) {\n  // Fallback sur le corps de l'email si le scraping a échoué\n  const emailData = $('Gmail Get message complet').item.json;\n  let texte = item.json.contenu_propre \n    || emailData.text \n    || emailData.snippet \n    || '';\n\n  // Extraction des URLs\n  const urls = texte.match(/\\[(https?:\\/\\/[^\\]]+)\\]/g) || [];\n  const sources = [];\n  urls.forEach(urlStr => {\n    const url = urlStr.replace(/[\\[\\]]/g, '');\n    if (!url.includes('tpeactu.fr') && \n        !url.match(/\\.(jpg|jpeg|png|gif)$/i) && \n        !url.includes('wp.com')) {\n      sources.push(url);\n    }\n  });\n\n  texte = texte.split(/PARTAGER\\s*:/)[0];\n  texte = texte.replace(/\\[https?:\\/\\/[^\\]]+\\]/g, '');\n  texte = texte.replace(/^\\s*\\d+[–-]\\d+\\s*minutes/im, '');\n  texte = texte.replace(/^.*via canva\\.com.*$/im, '');\n  texte = texte.replace(/\\n\\s*\\n/g, '\\n\\n').trim();\n\n  returnItems.push({\n    json: {\n      ...item.json,\n      texte_propre: texte,\n      sources_externes: sources\n    }\n  });\n}\nreturn returnItems;"
      },
