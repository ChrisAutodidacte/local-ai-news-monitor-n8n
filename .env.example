# =============================================================================
#  Configuration — Local AI News Monitor & Newsletter (n8n + Ollama)
# =============================================================================
#  Copy this file to ".env" and set your own secure values:
#      cp .env.example .env
#  The ".env" file MUST NEVER be committed (it is already in .gitignore).
# =============================================================================

# --- PostgreSQL Database -----------------------------------------------------
DB_USER=monitor
DB_PASSWORD=change-this-secure-password
DB_NAME=n8n_db

# --- Timezone (n8n scheduling & timestamps) ----------------------------------
TZ=UTC

# --- Flask Admin Secret Key --------------------------------------------------
# Generate a random key, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-flask-secret-key

# --- SearXNG Secret Key ------------------------------------------------------
# Generate a random 32-byte hex string, e.g.:  openssl rand -hex 32
SEARXNG_SECRET=change-this-searxng-secret-key
